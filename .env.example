# Copy to .env.local for development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Public URL of the site (no trailing slash). Used for canonical URLs, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres connection string (Neon console → Connect → "Pooled connection").
# Optional: without it the site still works, the grid game uses browser storage only,
# and the contact form relies on email delivery alone.
DATABASE_URL=

# Web3Forms access key (free at https://web3forms.com). This key is designed to be public:
# it can only send form emails to the inbox it was created for.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Long random string used to hash IP addresses for rate limiting. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=
